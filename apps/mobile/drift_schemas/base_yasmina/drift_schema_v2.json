      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"historique_niveaux\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profil_id\" INTEGER NOT NULL REFERENCES profils(id)ON DELETE CASCADE, \"niveau\" INTEGER NOT NULL CHECK (niveau BETWEEN 1 AND 6), \"debut\" TEXT NOT NULL, \"fin\" TEXT);"
        }
      ]
