    {
      "name": "profils",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profils\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"prenom\" TEXT NOT NULL COLLATE NOCASE UNIQUE CHECK (length(prenom) BETWEEN 1 AND 20 AND prenom = trim(prenom)), \"niveau\" INTEGER NOT NULL CHECK (niveau BETWEEN 1 AND 6), \"avatar\" TEXT NOT NULL, \"forme_adresse\" TEXT NOT NULL, \"cree_le\" TEXT NOT NULL, \"modifie_le\" TEXT NOT NULL);"
        }
      ]
    },
    {
