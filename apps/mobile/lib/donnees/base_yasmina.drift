import 'package:moteur_exercices/moteur_exercices.dart';
import '../profils/avatar.dart';

-- Profils enfants : 5 au maximum par appareil (déclencheur limite_cinq_profils).
-- Aucune autre donnée personnelle que le prénom ou pseudo.
CREATE TABLE profils (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  prenom TEXT NOT NULL COLLATE NOCASE UNIQUE
    CHECK (length(prenom) BETWEEN 1 AND 20 AND prenom = trim(prenom)),
  niveau INTEGER NOT NULL CHECK (niveau BETWEEN 1 AND 6),
  avatar ENUMNAME(Avatar) NOT NULL,
  forme_adresse ENUMNAME(FormeAdresse) NOT NULL,
  cree_le DATETIME NOT NULL,
  modifie_le DATETIME NOT NULL
) AS ProfilEnfant;

-- Une ligne par période passée dans un niveau. fin est NULL pour le niveau
-- en cours. Supprimée avec le profil.
CREATE TABLE historique_niveaux (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  profil_id INTEGER NOT NULL REFERENCES profils (id) ON DELETE CASCADE,
  niveau INTEGER NOT NULL CHECK (niveau BETWEEN 1 AND 6),
  debut DATETIME NOT NULL,
  fin DATETIME
) AS PeriodeNiveau;

CREATE INDEX historique_profil ON historique_niveaux (profil_id);

-- Un seul niveau en cours par profil.
CREATE UNIQUE INDEX historique_un_seul_en_cours
  ON historique_niveaux (profil_id) WHERE fin IS NULL;

CREATE TRIGGER limite_cinq_profils BEFORE INSERT ON profils
  WHEN (SELECT COUNT(*) FROM profils) >= 5
BEGIN
  SELECT RAISE(ABORT, 'limite_profils');
END;

-- Progression locale (A3-03). Résultat du dernier passage sur un exercice,
-- par profil : essais, réussi (juste au 1er ou au 2e essai, ou sans note),
-- révélé (réponse montrée après deux essais faux). Supprimé avec le profil.
CREATE TABLE resultats_exercices (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  profil_id INTEGER NOT NULL REFERENCES profils (id) ON DELETE CASCADE,
  etape_id TEXT NOT NULL,
  sequence_id TEXT NOT NULL,
  exercice_id TEXT NOT NULL,
  essais INTEGER NOT NULL CHECK (essais >= 0),
  reussi BOOLEAN NOT NULL,
  revele BOOLEAN NOT NULL,
  joue_le DATETIME NOT NULL
) AS ResultatExercice;

-- Un seul résultat par exercice et par profil (le dernier passage).
CREATE UNIQUE INDEX resultats_exercices_unique
  ON resultats_exercices (profil_id, exercice_id);

CREATE INDEX resultats_exercices_etape
  ON resultats_exercices (profil_id, etape_id);

-- État d'une étape pour un profil : en cours (index_reprise est le prochain
-- exercice à jouer, reussis le compte de la partie en cours) ou faite
-- (meilleurs_reussis garde la meilleure partie). Supprimé avec le profil.
CREATE TABLE etats_etapes (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  profil_id INTEGER NOT NULL REFERENCES profils (id) ON DELETE CASCADE,
  etape_id TEXT NOT NULL,
  faite BOOLEAN NOT NULL DEFAULT FALSE,
  index_reprise INTEGER NOT NULL DEFAULT 0 CHECK (index_reprise >= 0),
  reussis INTEGER NOT NULL DEFAULT 0 CHECK (reussis >= 0),
  total INTEGER NOT NULL DEFAULT 0 CHECK (total >= 0),
  meilleurs_reussis INTEGER NOT NULL DEFAULT 0 CHECK (meilleurs_reussis >= 0),
  commence_le DATETIME NOT NULL,
  termine_le DATETIME,
  modifie_le DATETIME NOT NULL
) AS EtatEtapeProfil;

CREATE UNIQUE INDEX etats_etapes_unique ON etats_etapes (profil_id, etape_id);
